NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://xuan_app:change-me@localhost:5433/xuan_dev
CORS_ORIGINS=http://localhost:3000
DOCS_ENABLED=false
# .env.test (git-ignored) uses NODE_ENV=test and DATABASE_URL=.../xuan_test
# Google sign-in (Google Cloud Console → OAuth client "Web application"); never commit real values
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# Web app origin to return to after sign-in; must be one of CORS_ORIGINS
AUTH_WEB_URL=http://localhost:3000
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_COOKIE_SECRET=change-me-to-32-or-more-random-characters
# false only for plain-http local development; always true in production
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=14
# Comma-separated Google emails that become admin on sign-in (bootstrap; removal never demotes)
AUTH_ADMIN_EMAILS=
