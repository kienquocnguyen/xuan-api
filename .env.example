NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://xuan_app:change-me@localhost:5433/xuan_dev
CORS_ORIGINS=http://localhost:3000
DOCS_ENABLED=false
# .env.test (git-ignored) uses NODE_ENV=test and DATABASE_URL=.../xuan_test
# Google sign-in (Google Cloud Console → OAuth client "Web application"); never commit real values
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# Web app origin to return to after sign-in; must be one of CORS_ORIGINS
AUTH_WEB_URL=http://localhost:3000
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_COOKIE_SECRET=change-me-to-32-or-more-random-characters
# false only for plain-http local development; always true in production
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=14
# Comma-separated Google emails that become admin on sign-in (bootstrap; removal never demotes)
AUTH_ADMIN_EMAILS=

# Blog media (blog completion spec §5.3). Development/test default to local disk under storage/ (git-ignored),
# served at http://localhost:<PORT>/media. Production must choose r2 or disabled; local is refused there.
# MEDIA_STORAGE=local
# MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media
# MEDIA_LOCAL_DIR=storage/media
# With MEDIA_STORAGE=disabled, keep MEDIA_PUBLIC_BASE_URL set if posts already use uploaded images: uploads stop,
# but stored images keep resolving (https in production).
# Cloudflare R2 (only with MEDIA_STORAGE=r2): a bucket, its public custom domain as MEDIA_PUBLIC_BASE_URL (https),
# and an API token scoped to that bucket (Object Read & Write). Never commit real values.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Proxies in front of the API (contact form design CF-8). Default: 1 in production (Vercel's edge), 0 elsewhere.
# TRUST_PROXY_HOPS=1

# Contact form (/lien-he; contact form design §5). Without RECAPTCHA_SECRET_KEY, development and test skip the
# check, and production answers every submission with 503 CONTACT_FORM_UNAVAILABLE (fail closed).
# reCAPTCHA v3 (Google reCAPTCHA admin console → a v3 site key for the web's domains; the secret stays here).
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_ALLOWED_HOSTNAMES=xuancreative.com,www.xuancreative.com
# RECAPTCHA_MIN_SCORE=0.5
# Notification email through Resend: all three or none. Without them, submissions are still stored and their
# notifications are recorded as failed (NOT_CONFIGURED). CONTACT_EMAIL_FROM must be on a domain verified in Resend.
# One attempt per submission; an admin retries failed ones from the inbox (no scheduled retries).
# RESEND_API_KEY=
# CONTACT_EMAIL_FROM=XuanCreative <contact@example.com>
# CONTACT_NOTIFICATION_TO=inbox@example.com

# VNPAY payment gateway (course sales spec §5.7): all four or none. Without them, checkout answers
# 503 PAYMENTS_UNAVAILABLE. Sandbox credentials come from VNPAY's onboarding email; never commit real values.
# The IPN URL (https://<api>/payments/vnpay/ipn) is registered with VNPAY, not set here.
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=http://localhost:3000/khoa-hoc/thanh-toan/ket-qua
